# ---------- Server ----------
PORT=3001

# Database. Leave DATABASE_URL empty to use the embedded Postgres (PGlite),
# which stores its files in server/data/pgdata and needs no installation.
# For a real Postgres / Supabase-hosted Postgres, set a connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/signsense
DATABASE_URL=
# Set to "true" for hosted Postgres that requires TLS (e.g. Supabase).
DATABASE_SSL=false

# ---------- Optional AI tiers (feature-flagged; the app works fully without them) ----------
# Sentence assembly (sign -> English) and concept extraction (speech -> sign)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Server-side speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint)
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
